# the Windows setup: `kago build` builds the app and the SteamVR driver
# and client, then writes the setup to dist/. the driver and client need
# their CMake build folders configured once in ../aira-motion/aira-openvr.
package dev.eira.aira-studio
  name Aira Studio
  version from cargo
  publisher Eira
  description Set up and watch Aira trackers
  # the setup asks: for everyone, or only for me
  scope choose

license LICENSE

source motion
  dir ../aira-motion

# `kago build --no-build` packs what is built already.
build
  cargo build --release
  when windows
    cmake --build ../aira-motion/aira-openvr/driver/build --config Release
    cmake --build ../aira-motion/aira-openvr/client/build --config Release

require windows 10.0.17763

app aira-studio
  windows target/release/aira-studio.exe
  # remake with: aira-studio --export-icon packaging/windows/aira.ico
  icon windows packaging/windows/aira.ico

shortcut

component steamvr "SteamVR support" required
  about Shows Aira trackers in SteamVR and reads the headset
  detect steamvr
  when windows
    steamvr motion:aira-openvr/driver/build/aira
    copy motion:aira-openvr/client/build/out/aira_openvr_client.dll
    copy motion:aira-openvr/client/build/out/openvr_api.dll

component desktop "Desktop shortcut" off
  shortcut desktop

# settings and recordings; removed only when the person ticks "also
# remove my settings and data" at uninstall.
purge %APPDATA%/Aira
