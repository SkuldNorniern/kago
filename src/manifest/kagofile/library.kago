# kago's own checks and actions, in the same Kagofile syntax anyone can
# write. a Kagofile can use them by name, or define its own with the same
# name to replace them.

# SteamVR writes the runtime folder here once it has run.
check steamvr "SteamVR"
  json %LOCALAPPDATA%/openvr/openvrpaths.vrpath runtime

# a SteamVR driver folder: installed, and added to SteamVR's driver list
# the way `vrpathreg adddriver` does it.
#   steamvr build:driver/aira
action steamvr dir to={app}/steamvr/$dir.name
  expect $dir/driver.vrdrivermanifest "a SteamVR driver folder holds driver.vrdrivermanifest; point `steamvr` at that folder"
  copy $dir -> $to
  json %LOCALAPPDATA%/openvr/openvrpaths.vrpath
    init jsonid vrpathreg
    init version 1
    add external_drivers $to

# the Visual C++ 2015-2022 runtime, x64, from its vc_redist.x64.exe. a
# newer one installed already makes it exit with 1638, which counts as
# done.
#   vcredist vcredist:vc_redist.x64.exe
action vcredist file
  prerequisite vcredist "Microsoft Visual C++ Runtime"
    file $file
    arguments /install /quiet /norestart
    detect registry HKLM\SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64 Installed
    admin

# the Evergreen WebView2 runtime, through its bootstrapper.
#   webview2 webview2:MicrosoftEdgeWebview2Setup.exe
action webview2 file
  prerequisite webview2 "Microsoft Edge WebView2 Runtime"
    file $file
    arguments /silent /install
    detect registry HKLM\SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5} pv
    admin

# a file type one of the package's programs opens: double-clicking such a
# file starts the program with it. the extension starts with a dot.
#   file-type .airaproj AiraStudio.Project "Aira project" {app}/aira-studio.exe
# the document gets its own icon, apart from the program's, and a longer
# description (the fifth word, quoted) for Explorer's Type column. the
# icon is a path in the install, so a `copy` puts the .ico there.
#   file-type .airaproj AiraStudio.Project "Aira project" {app}/aira-studio.exe "Aira Studio project file" icon={app}/airaproj.ico
action file-type ext id name program description=$name icon=$program
  registry Software\Classes\$ext
    set @ $id
  registry Software\Classes\$id
    set @ $name
    set FriendlyTypeName $description
  registry Software\Classes\$id\DefaultIcon
    set @ "$icon,0"
  registry Software\Classes\$id\shell\open\command
    set @ "\"$program\" \"%1\""

# a URL protocol: links like aira://pair?code=1 start the program with
# the whole link.
#   url-protocol aira "Aira Studio" {app}/aira-studio.exe
action url-protocol scheme name program
  registry Software\Classes\$scheme
    set @ "URL:$name"
    set "URL Protocol" ""
  registry Software\Classes\$scheme\shell\open\command
    set @ "\"$program\" \"%1\""
